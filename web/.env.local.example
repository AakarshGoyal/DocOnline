# Copy this file to .env.local and fill in the two values below.
# You get both from your Supabase project: Project Settings -> API.
# .env.local is never committed to git (see .gitignore) -- that's on
# purpose, these values are specific to your own Supabase project.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From your Stripe dashboard (Developers -> API keys). Use the *test
# mode* secret key (starts with sk_test_) while trying things out --
# never commit a live (sk_live_) key anywhere.
STRIPE_SECRET_KEY=<paste-your-stripe-test-secret-key-here>
